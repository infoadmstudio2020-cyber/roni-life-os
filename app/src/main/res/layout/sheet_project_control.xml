<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_hud_handle" />

    <TextView
        style="@style/Widget.RONiLiFEOS.HudLabel"
        android:layout_marginTop="14dp"
        android:text="@string/hud_sheet_tag"
        android:textColor="@color/hud_accent" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/hud_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="DEMO WEB APP" />

    <TextView
        android:id="@+id/sheet_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/hud_text_dim"
        android:textSize="10sp"
        tools:text="asset · running" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/hud_line" />

    <LinearLayout
        android:id="@+id/sheet_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/sheet_sessions_label"
        style="@style/Widget.RONiLiFEOS.HudLabel"
        android:layout_marginTop="18dp"
        android:text="@string/pm_other_sessions" />

    <LinearLayout
        android:id="@+id/sheet_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/sheet_sessions_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="@string/pm_no_other_sessions"
        android:textColor="@color/hud_text_dim"
        android:textSize="10sp" />
</LinearLayout>
