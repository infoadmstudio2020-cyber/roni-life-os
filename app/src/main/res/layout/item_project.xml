<?xml version="1.0" encoding="utf-8"?>
<!--
    Registry row — Industrial HUD console line.
    Index column, square signal badge, monospaced metadata, sharp border.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_hud_row_clickable"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <!-- Index rail -->
    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:background="@color/hud_panel_alt"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/project_index"
            style="@style/Widget.RONiLiFEOS.HudIndex"
            tools:text="01" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@color/hud_line" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/project_badge"
            android:layout_width="@dimen/badge_size"
            android:layout_height="@dimen/badge_size"
            android:background="@drawable/bg_hud_badge"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/hud_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:textColor="@color/hud_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="DEMO WEB APP" />

                <TextView
                    android:id="@+id/project_default_chip"
                    style="@style/Widget.RONiLiFEOS.HudChipAccent"
                    android:layout_marginStart="8dp"
                    android:text="@string/project_default_chip"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/project_running_chip"
                    style="@style/Widget.RONiLiFEOS.HudChipAccent"
                    android:layout_marginStart="6dp"
                    android:text="@string/pm_running_chip"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/project_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="@color/hud_text_dim"
                android:textSize="10sp"
                tools:text="Bundled demo web application for the NativeRuntime ecosystem." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/project_source_chip"
                    style="@style/Widget.RONiLiFEOS.HudChip"
                    tools:text="ASSET · ZIP_ASSET" />

                <TextView
                    android:id="@+id/project_splash_chip"
                    style="@style/Widget.RONiLiFEOS.HudChip"
                    android:layout_marginStart="5dp"
                    tools:text="SPLASH ON" />

                <TextView
                    android:id="@+id/project_bootstrap_chip"
                    style="@style/Widget.RONiLiFEOS.HudChip"
                    android:layout_marginStart="5dp"
                    tools:text="BOOT ON" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/project_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_about"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/hud_text_dim" />
    </LinearLayout>
</LinearLayout>
