<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_void"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        style="@style/Widget.RONiLiFEOS.HudLabel"
        android:text="@string/hud_error_code"
        android:textColor="@color/hud_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="@string/error_title"
        android:textAllCaps="true"
        android:textColor="@color/hud_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hud_console"
        android:fontFamily="monospace"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/hud_text_dim"
        android:textSize="10sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/error_retry"
        style="@style/Widget.RONiLiFEOS.HudButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:text="@string/error_retry"
        app:icon="@drawable/ic_refresh" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/error_back"
        style="@style/Widget.RONiLiFEOS.HudButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/error_back" />
</LinearLayout>
