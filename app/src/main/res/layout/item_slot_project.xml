<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_hud_row_clickable"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="6dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/slot_item_badge"
        android:layout_width="@dimen/badge_size"
        android:layout_height="@dimen/badge_size"
        android:background="@drawable/bg_hud_badge"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/hud_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/slot_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/hud_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="PORTFOLIO" />

        <TextView
            android:id="@+id/slot_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/hud_text_dim"
            android:textSize="10sp"
            tools:text="file · index.html" />

        <TextView
            android:id="@+id/slot_item_status"
            style="@style/Widget.RONiLiFEOS.HudChipAccent"
            android:layout_marginTop="8dp"
            tools:text="REGISTERED" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/slot_item_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/slot_action_configure"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/hud_text_dim" />
</LinearLayout>
