<?xml version="1.0" encoding="utf-8"?>
<!--
    Native splash surface — Industrial HUD boot screen.
    Colours are placeholders: SplashActivity overrides the background, the accent bar and the
    logo colour from AppConfig at runtime.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_void">

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <View
            android:id="@+id/splash_accent"
            android:layout_width="56dp"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp"
            android:background="@color/hud_accent" />

        <TextView
            android:id="@+id/splash_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/hud_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="@string/splash_subtitle"
            android:textAllCaps="true"
            android:textColor="@color/hud_text_dim"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/hud_accent" />

        <TextView
            android:id="@+id/splash_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="@string/splash_tap_to_skip"
            android:textAllCaps="true"
            android:textColor="@color/hud_text_dim"
            android:textSize="9sp" />

    </LinearLayout>

</FrameLayout>
