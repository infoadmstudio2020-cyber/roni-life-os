<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hud_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <TextView
        style="@style/Widget.RONiLiFEOS.HudLabel"
        android:text="@string/hud_settings_tag"
        android:textColor="@color/hud_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:text="@string/settings_dashboard_mode"
        android:textAllCaps="true"
        android:textColor="@color/hud_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/group_dashboard_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_dashboard_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/hud_accent"
            android:fontFamily="monospace"
            android:text="@string/dashboard_mode_native"
            android:textColor="@color/hud_text"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/radio_dashboard_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/hud_accent"
            android:fontFamily="monospace"
            android:text="@string/dashboard_mode_web"
            android:textColor="@color/hud_text"
            android:textSize="11sp" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="monospace"
        android:text="@string/settings_dashboard_hint"
        android:textColor="@color/hud_text_dim"
        android:textSize="9sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/hud_line" />

    <com.roni.library.ui.widget.SafeSwitchCompat
        android:id="@+id/switch_app_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/settings_dashboard_enabled"
        android:textColor="@color/hud_text"
        android:textOff="@string/switch_off"
        android:textOn="@string/switch_on"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="monospace"
        android:text="@string/settings_dashboard_enabled_hint"
        android:textColor="@color/hud_text_dim"
        android:textSize="9sp" />

    <com.roni.library.ui.widget.SafeSwitchCompat
        android:id="@+id/switch_app_splash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/settings_splash"
        android:textColor="@color/hud_text"
        android:textOff="@string/switch_off"
        android:textOn="@string/switch_on"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="monospace"
        android:text="@string/settings_splash_hint"
        android:textColor="@color/hud_text_dim"
        android:textSize="9sp" />

    <com.roni.library.ui.widget.SafeSwitchCompat
        android:id="@+id/switch_app_bootstrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/settings_bootstrap"
        android:textColor="@color/hud_text"
        android:textOff="@string/switch_off"
        android:textOn="@string/switch_on"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="monospace"
        android:text="@string/settings_bootstrap_hint"
        android:textColor="@color/hud_text_dim"
        android:textSize="9sp" />

    <com.roni.library.ui.widget.SafeSwitchCompat
        android:id="@+id/switch_app_telemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/settings_telemetry"
        android:textColor="@color/hud_text"
        android:textOff="@string/switch_off"
        android:textOn="@string/switch_on"
        android:textSize="12sp" />

    <com.roni.library.ui.widget.SafeSwitchCompat
        android:id="@+id/switch_app_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="@string/settings_debug"
        android:textColor="@color/hud_text"
        android:textOff="@string/switch_off"
        android:textOn="@string/switch_on"
        android:textSize="12sp" />

</LinearLayout>
