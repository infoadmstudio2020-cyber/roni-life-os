    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ============================================================
         Industrial HUD palette — obsidian console.
         Strictly: black, dark gray, light gray, neon orange.
         ============================================================ -->
    <color name="hud_void">#FF020202</color>
    <color name="hud_panel">#FF0A0A0A</color>
    <color name="hud_panel_alt">#FF0F0F0F</color>
    <color name="hud_panel_deep">#FF050505</color>
    <color name="hud_line">#FF333333</color>
    <color name="hud_line_soft">#FF1E1E1E</color>
    <color name="hud_text">#FFE0E0E0</color>
    <color name="hud_text_dim">#FF888888</color>
    <color name="hud_accent">#FFFF4500</color>
    <color name="hud_accent_deep">#FFCC3700</color>
    <color name="hud_accent_dim">#FF7A2200</color>
    <color name="hud_accent_wash">#FF1A0A00</color>
    <color name="hud_accent_ghost">#33FF4500</color>
    <color name="hud_grid">#14FFFFFF</color>
    <color name="hud_scan">#0AFF4500</color>

    <!-- Semantic aliases consumed by the rest of the consumer app -->
    <color name="brand_primary">@color/hud_accent</color>
    <color name="brand_primary_dark">@color/hud_accent_deep</color>
    <color name="brand_primary_light">@color/hud_accent_wash</color>
    <color name="brand_accent">@color/hud_accent</color>
    <color name="brand_accent_light">@color/hud_accent_wash</color>

    <color name="surface">@color/hud_panel</color>
    <color name="surface_alt">@color/hud_void</color>
    <color name="surface_elevated">@color/hud_panel_alt</color>
    <color name="text_primary">@color/hud_text</color>
    <color name="text_secondary">@color/hud_text_dim</color>
    <color name="divider">@color/hud_line</color>

    <color name="state_success">@color/hud_accent</color>
    <color name="state_warning">#FFFF8A1F</color>
    <color name="state_danger">#FFFF2D00</color>

    <!-- Tap feedback on obsidian surfaces: white at ~10% stays visible without glare. -->
    <color name="ripple_light">#1AFFFFFF</color>

    <color name="splash_gradient_start">@color/hud_void</color>
    <color name="splash_gradient_end">@color/hud_panel</color>

