<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime Inspector palette.

  Owned by native-dev-tools-sdk: the inspector is a library component, so its colours must
  travel with it. The host application no longer declares these names, which keeps a single
  definition and avoids a duplicate-resource override.
-->
<resources>
    <color name="inspector_bg">#020202</color>
    <color name="inspector_surface">#0A0A0A</color>
    <color name="inspector_text">#E0E0E0</color>
    <color name="inspector_text_dim">#888888</color>
    <color name="inspector_accent">#FF4500</color>
    <color name="inspector_line">#333333</color>
    <color name="inspector_warn">#FFB300</color>
    <color name="inspector_error">#FF4500</color>
    <color name="inspector_debug">#4A9EFF</color>
    <color name="inspector_selected">#1A1A1A</color>
    <color name="inspector_text_muted">#A8A8A8</color>
    <color name="inspector_chip_bg">#141414</color>
    <color name="inspector_error_text">#FF6A33</color>
    <color name="inspector_warn_text">#FFC233</color>
    <color name="inspector_debug_text">#6FB6FF</color>
    <color name="inspector_error_chip">#2A0F08</color>
    <color name="inspector_warn_chip">#2A2008</color>
    <color name="inspector_debug_chip">#0A1A2A</color>
</resources>
