<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime Inspector bottom sheet.

  Zero corner radius, zero elevation: the sheet is a flat HUD panel that sits on top of the
  running project. The root is a plain LinearLayout so the host can drive its height directly
  while dragging between the three states.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inspector_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inspector_bg">

    <!-- Drag handle: the only touch target that resizes the sheet. -->
    <View
        android:id="@+id/inspector_handle"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@color/inspector_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:background="@color/inspector_surface">

        <TextView
            android:id="@+id/inspector_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="RUNTIME INSPECTOR"
            android:textColor="@color/inspector_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inspector_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="COLLAPSED"
            android:textColor="@color/inspector_text_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="PAUSE"
            android:textColor="@color/inspector_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_autoscroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="AUTO"
            android:textColor="@color/inspector_accent"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="CLEAR"
            android:textColor="@color/inspector_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="EXPORT"
            android:textColor="@color/inspector_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="SET"
            android:textColor="@color/inspector_text_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inspector_line" />

    <HorizontalScrollView
        android:id="@+id/inspector_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:scrollbars="none"
        android:background="@color/inspector_bg">

        <LinearLayout
            android:id="@+id/inspector_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inspector_line" />

    <!-- Level filters: multi-select. Nothing selected means "all levels". -->
    <LinearLayout
        android:id="@+id/inspector_levels"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/inspector_bg">

        <TextView
            android:id="@+id/inspector_level_error"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ERROR"
            android:textColor="@color/inspector_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inspector_level_warn"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="WARN"
            android:textColor="@color/inspector_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inspector_level_info"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="INFO"
            android:textColor="@color/inspector_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/inspector_level_all"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ALL"
            android:textColor="@color/inspector_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inspector_line" />

    <LinearLayout
        android:id="@+id/inspector_filters"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/inspector_surface">

        <EditText
            android:id="@+id/inspector_search"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@color/inspector_bg"
            android:fontFamily="monospace"
            android:hint="search text / tag / request id"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/inspector_text"
            android:textColorHint="@color/inspector_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/inspector_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/inspector_bg"
        android:fontFamily="monospace"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textColor="@color/inspector_text_dim"
        android:textSize="9sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/inspector_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inspector_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- Empty state: shown instead of the list when nothing matches. -->
        <LinearLayout
            android:id="@+id/inspector_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_inspector_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="NO LOGS"
                android:textColor="@color/inspector_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/inspector_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Events appear here as the project runs."
                android:textColor="@color/inspector_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inspector_line" />

    <LinearLayout
        android:id="@+id/inspector_footer"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/inspector_surface">

        <TextView
            android:id="@+id/inspector_selection_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="@color/inspector_text_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="SELECT ALL"
            android:textColor="@color/inspector_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/inspector_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="COPY"
            android:textColor="@color/inspector_accent"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
